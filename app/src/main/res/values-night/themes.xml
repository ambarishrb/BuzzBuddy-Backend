<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartAlarm" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/app_theme</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/app_theme</item>
        <item name="colorOnSurface">@color/your_text_color</item>
        <item name="colorOnBackground">@color/your_text_color</item>
        <item name="android:textColor">@color/your_text_color</item>
        <item name="android:textColorPrimary">@color/your_text_color</item>
        <item name="android:textColorHint">@color/secondary_text</item>
        <item name="android:editTextColor">@color/your_text_color</item>
        <item name="android:statusBarColor">@color/app_theme</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>