<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/settingsBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:background="#fefefe">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginTop="5dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="5dp"
            app:title="@string/settings_title"
            app:titleTextColor="@color/black" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_section"
                android:textStyle="bold"
                android:textColor="#525A69"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"/>

            <LinearLayout
                android:id="@+id/layoutAccountInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_bg"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:elevation="1dp"
                android:layout_marginBottom="10dp"
                android:paddingVertical="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvAccountName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_name_placeholder"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAccountEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/account_email_placeholder"
                    android:textColor="#525A69"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGuestAccountHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/login_to_sync_alarms"
                android:textColor="#525A69"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:elevation="1dp"
                android:layout_marginBottom="10dp"
                android:paddingVertical="12dp"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_login"
                    android:textColor="@color/app_theme"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:elevation="1dp"
                android:layout_marginBottom="10dp"
                android:paddingVertical="12dp"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_register"
                    android:textColor="@color/app_theme"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:elevation="1dp"
                android:layout_marginBottom="10dp"
                android:paddingVertical="12dp"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/change_password"
                    android:textColor="@color/black"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:elevation="1dp"
                android:layout_marginBottom="10dp"
                android:paddingVertical="12dp"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/log_out"
                    android:textColor="@color/app_theme"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:elevation="1dp"
                android:layout_marginBottom="10dp"
                android:paddingVertical="12dp"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/delete_account"
                    android:textColor="@color/crimson"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- GENERAL Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_general"
                android:textStyle="bold"
                android:textColor="#525A69"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"/>

            <!-- Snooze Duration -->
            <LinearLayout
                android:id="@+id/layoutSnooze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:elevation="1dp"
                android:paddingVertical="8dp"
                android:paddingStart="6dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/settings_snooze_duration"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSnoozeDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="4dp"
                    android:text="@string/settings_snooze_placeholder"
                    android:textColor="@android:color/black" />

                <ImageView
                    android:id="@+id/btnEditSnooze"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/content_description_edit_snooze"
                    android:src="@drawable/ic_settings_trigger"
                    app:tint="#8E8e93" />
            </LinearLayout>

            <!-- ALARM Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_alarm"
                android:textStyle="bold"
                android:textColor="#525A69"
                android:paddingTop="18dp"
                android:paddingBottom="4dp"/>

            <!-- Alarm Sound -->
            <LinearLayout
                android:id="@+id/layoutAlarmSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:background="@drawable/rounded_bg"
                android:paddingVertical="8dp"
                android:paddingStart="6dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/settings_alarm_sound"
                    android:textColor="@color/black"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvAlarmSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alarm_sound_sunrise"
                    android:textColor="@android:color/black"
                    android:paddingEnd="4dp" />

                <ImageView
                    android:id="@+id/btnChangeSound"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings_trigger"
                    app:tint="#8E8e93"
                    android:contentDescription="@string/content_description_change_sound"/>
            </LinearLayout>

            <!-- Alarm Volume -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_alarm_volume"
                android:layout_marginTop="6dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"/>

            <SeekBar
                android:id="@+id/seekBarVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:thumbTint="#e14f62"
                android:progressTint="#e14f62"
                android:max="100"
                android:progress="50"/>

            <!-- Gradual Volume Increase -->
            <LinearLayout
                android:id="@+id/layoutGradualVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:background="@drawable/rounded_bg"
                android:layout_marginBottom="10dp"
                android:paddingVertical="8dp"
                android:paddingStart="6dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_gradual_volume"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="16sp"
                    android:textColor="@color/black"/>

                <Switch
                    android:id="@+id/switchGradualVolume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:trackTint="#9ba1ac"
                    android:thumbTint="#e14f62"/>
            </LinearLayout>

            <!-- Vibrate -->
            <LinearLayout
                android:id="@+id/layoutVibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:background="@drawable/rounded_bg"
                android:layout_marginBottom="10dp"
                android:paddingVertical="8dp"
                android:paddingStart="6dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/settings_vibrate"
                    android:textSize="16sp"
                    android:textColor="@color/black"/>

                <Switch
                    android:id="@+id/switchVibrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:trackTint="#9ba1ac"
                    android:thumbTint="#e14f62"/>
            </LinearLayout>

            <!-- Auto Dismiss -->
            <LinearLayout
                android:id="@+id/layoutAutoDismiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:background="@drawable/rounded_bg"
                android:layout_marginBottom="10dp"
                android:paddingVertical="8dp"
                android:paddingStart="6dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_auto_dismiss"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="16sp"
                    android:textColor="@color/black"/>

                <Switch
                    android:id="@+id/switchAutoDismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:trackTint="#9ba1ac"
                    android:thumbTint="#e14f62"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
