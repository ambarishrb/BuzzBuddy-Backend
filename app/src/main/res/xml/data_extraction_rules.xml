<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="smart_alarms" />
        <include domain="sharedpref" path="buzz_settings.xml" />
        <include domain="sharedpref" path="buzz_snooze.xml" />
        <!-- Don't sync the auth token / email cache to other devices. -->
        <exclude domain="sharedpref" path="MyPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="smart_alarms" />
        <include domain="sharedpref" path="buzz_settings.xml" />
        <include domain="sharedpref" path="buzz_snooze.xml" />
    </device-transfer>
</data-extraction-rules>
